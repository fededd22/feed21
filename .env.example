# APP_URL: The public URL/domain where this server is hosted (e.g. Cloud Run
# service URL). Used to build the vless://, vmess://, trojan:// client links
# sent by the Telegram bot (host/sni fields). AI Studio / Cloud Run usually
# inject this automatically -- if running elsewhere, set it manually.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Token of the Telegram bot that serves as the ONLY admin
# interface for this server. REQUIRED -- there is no hardcoded fallback
# token; the app refuses to start without this set to your own bot's token.
TELEGRAM_BOT_TOKEN="put-your-own-bot-token-here"

# SSH_USERNAME / SSH_PASSWORD: initial credentials for the Dropbear SSH
# tunnel (reachable over the same domain:443, path /by_moon_ssh -- see
# "🔐 SSH" in the bot menu). Only used the very first time the account is
# created; after that, the admin can change the username/password live from
# the bot itself (buttons under "🔐 SSH"), which takes effect immediately
# and is remembered in DATA_DIR/ssh-credentials.json without needing a
# redeploy or env var change. Defaults to vpsuser/vpspass if unset -- change
# this before exposing the deployment to anyone you don't fully trust.
SSH_USERNAME="vpsuser"
SSH_PASSWORD="vpspass"

# TELEGRAM_ADMIN_CHAT_ID: no longer used to determine bot ownership. The
# primary admin is now hardcoded directly in server.ts as
# HARDCODED_PRIMARY_ADMIN so it can never change or be lost regardless of
# env vars, redeploys, or a wiped admin.json -- to change it, edit that
# constant in server.ts and redeploy. This env var is kept only for
# reference/backward compatibility and has no effect.
# TELEGRAM_ADMIN_CHAT_ID="1726923679"

# DATA_DIR: where admin.json/settings.json/clients.json/detected-host.json
# are stored. Defaults to the app's working directory, which is ephemeral on
# Cloud Run. For durable client configs across redeploys, mount a persistent
# volume (e.g. a Cloud Run Volume Mount backed by Cloud Storage FUSE) and
# point DATA_DIR at its mount path.
DATA_DIR=""

# MURAD_SETUP_PASSWORD: password required on the "/" first-run setup page to
# register this deployment's own Telegram bot id/token (each fresh container
# starts with no bot configured; whoever submits the correct password first
# claims it, and it can never be changed afterwards -- see muradSetupPageHtml
# in server.ts). Falls back to "moon2026" if unset. STRONGLY RECOMMENDED:
# set your own value here before deploying, since the fallback is public
# (it's in this repo's source) and anyone who reaches your URL before you do
# could otherwise claim the setup.
MURAD_SETUP_PASSWORD=""
